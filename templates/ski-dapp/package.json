{
  "name": "ski-dapp",
  "version": "0.1.0",
  "description": ".SKI official reference dApp template for Thunderbun.ai (powered by sui.ski)",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/generate-icons.ts && vite",
    "build": "bun scripts/generate-icons.ts && bun --bun tsc -p tsconfig.json && bun --bun vite build",
    "preview": "vite preview",
    "icons:generate": "bun scripts/generate-icons.ts",
    "twa:prereqs": "bash scripts/check-prereqs.sh",
    "twa:setup": "npm install -g @bubblewrap/cli",
    "twa:keystore:debug": "bash scripts/gen-keystore.sh debug",
    "twa:keystore:release": "bash scripts/gen-keystore.sh release",
    "twa:init": "bubblewrap init --manifest=dist/manifest.webmanifest",
    "twa:build": "bubblewrap build --skipPwaValidation",
    "twa:update": "bubblewrap update",
    "twa:assetlinks": "bash scripts/gen-keystore.sh debug",
    "worker:typecheck": "tsc -p tsconfig.worker.json --noEmit",
    "worker:dev": "npx wrangler dev --port 8787",
    "deploy": "bun run build && npx wrangler deploy",
    "prod": "npx wrangler deploy --env production",
    "deploy:preview": "bun run build && npx wrangler deploy --env preview",
    "deploy:production": "bun run build && npx wrangler deploy --env production",
    "deploy:vercel": "npx vercel dist --prod",
    "deploy:netlify": "npx netlify deploy --prod --dir=dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:playstore": "vitest run --reporter=verbose tests/playstore/",
    "validate": "bun run test:playstore && tsc -p tsconfig.json --noEmit && echo 'All validations passed'"
  },
  "dependencies": {
    "@dika.sui/sdk": "github:arbuthnot-eth/dika",
    "@human.tech/waap-sdk": "file:vendor/waap-sdk",
    "@mysten/dapp-kit": "latest",
    "@mysten/dapp-kit-core": "^1.1.0",
    "@mysten/deepbook-v3": "^1.1.1",
    "@mysten/seal": "^1.0.1",
    "@mysten/sui": "^2.4.0",
    "@mysten/suins": "^1.0.2",
    "@mysten/wallet-standard": "^0.20.1",
    "@mysten/walrus": "^1.0.3",
    "@tanstack/react-query": "^5.90.21",
    "@x402/core": "^2.5.0",
    "@x402/hono": "^2.5.0",
    "@zkp2p/contracts-v2": "^0.0.9",
    "@zkp2p/sdk": "^0.0.13",
    "agents": "^0.5.1",
    "hono": "^4.12.3",
    "hono-agents": "^3.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sui.ski": "^0.1.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260305.0",
    "@resvg/resvg-js": "^2.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18",
    "workbox-window": "^7.4.0",
    "wrangler": "4.67.0"
  },
  "overrides": {
    "@mysten/sui": "2.4.0",
    "@human.tech/waap-sdk/@mysten/sui": "2.4.0",
    "@human.tech/waap-sdk/@mysten/wallet-standard": "0.20.1"
  }
}
