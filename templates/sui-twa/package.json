{
  "name": "my-sui-twa-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",

    "icons:generate": "bun add -D sharp && bun run scripts/generate-icons.ts",

    "twa:prereqs": "bash scripts/check-prereqs.sh",
    "twa:setup": "npm install -g @bubblewrap/cli",
    "twa:keystore:debug": "bash scripts/gen-keystore.sh debug",
    "twa:keystore:release": "bash scripts/gen-keystore.sh release",
    "twa:init": "bubblewrap init --manifest=dist/manifest.webmanifest",
    "twa:build": "bubblewrap build --skipPwaValidation",
    "twa:update": "bubblewrap update",
    "twa:assetlinks": "bash scripts/gen-keystore.sh debug",

    "worker:typecheck": "tsc -p tsconfig.worker.json --noEmit",
    "worker:dev": "wrangler dev --port 8787",

    "deploy": "bun run build && wrangler deploy",
    "deploy:preview": "bun run build && wrangler deploy --env preview",
    "deploy:production": "bun run build && wrangler deploy --env production",
    "deploy:vercel": "npx vercel dist --prod",
    "deploy:netlify": "npx netlify deploy --prod --dir=dist"
  },
  "dependencies": {
    "@human.tech/waap-sdk": "latest",
    "@mysten/dapp-kit-core": "^1.0.4",
    "@mysten/deepbook-v3": "latest",
    "@mysten/seal": "latest",
    "@mysten/sui": "^2.4.0",
    "@mysten/suins": "latest",
    "@mysten/wallet-standard": "latest",
    "agents": "latest",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.21.0",
    "wrangler": "latest",
    "workbox-window": "^7.0.0"
  }
}