{
  "name": "thunderbun",
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/generate-icons.ts && vite",
    "build": "bun scripts/generate-icons.ts && bunx tsc -p tsconfig.json && bunx vite build",
    "preview": "vite preview",
    "icons:generate": "bun scripts/generate-icons.ts",
    "twa:prereqs": "bash scripts/check-prereqs.sh",
    "twa:setup": "npm install -g @bubblewrap/cli",
    "twa:keystore:debug": "bash scripts/gen-keystore.sh debug",
    "twa:keystore:release": "bash scripts/gen-keystore.sh release",
    "twa:init": "bubblewrap init --manifest=dist/manifest.webmanifest",
    "twa:build": "bubblewrap build --skipPwaValidation",
    "twa:update": "bubblewrap update",
    "twa:assetlinks": "bash scripts/gen-keystore.sh debug",
    "worker:typecheck": "tsc -p tsconfig.worker.json --noEmit",
    "worker:dev": "wrangler dev --port 8787",
    "deploy": "bun run build && wrangler deploy",
    "deploy:preview": "bun run build && wrangler deploy --env preview",
    "deploy:production": "bun run build && wrangler deploy --env production",
    "deploy:vercel": "npx vercel dist --prod",
    "deploy:netlify": "npx netlify deploy --prod --dir=dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:playstore": "vitest run --reporter=verbose tests/playstore/",
    "validate": "bun run test:playstore && tsc -p tsconfig.json --noEmit && echo 'All validations passed'"
  },
  "dependencies": {
    "@human.tech/waap-sdk": "^1.2.0",
    "@ika.xyz/sdk": "^0.2.7",
    "@mysten/dapp-kit-core": "^1.0.4",
    "@mysten/deepbook-v3": "^1.0.12",
    "@mysten/seal": "^1.0.1",
    "@mysten/sui": "^2.4.0",
    "@mysten/suins": "^1.0.2",
    "@mysten/wallet-standard": "^0.20.1",
    "@mysten/walrus": "^1.0.3",
    "@x402/core": "^2.3.1",
    "@x402/hono": "^2.3.0",
    "agents": "^0.5.0",
    "hono": "^4.11.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260219.0",
    "@resvg/resvg-js": "^2.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18",
    "workbox-window": "^7.4.0",
    "wrangler": "^4.67.0"
  }
}
