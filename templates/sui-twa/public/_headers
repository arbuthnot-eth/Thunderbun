# Cloudflare Workers static-asset headers
# Placed in public/_headers, copied into dist/ by Vite and served by Workers
# for every static asset response.
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/

# Digital Asset Links — required content-type for TWA validation
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: no-cache, max-age=0

# PWA manifest
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache, max-age=0

# App shell entrypoints — always revalidate
/
  Cache-Control: no-cache, max-age=0, must-revalidate
/index.html
  Cache-Control: no-cache, max-age=0, must-revalidate
/registerSW.js
  Cache-Control: no-cache, max-age=0, must-revalidate

# Service worker — must not be cached
/sw.js
  Cache-Control: no-cache, max-age=0
  Service-Worker-Allowed: /

# Immutable hashed assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Security headers on all routes
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
